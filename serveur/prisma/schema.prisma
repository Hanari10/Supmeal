generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

model User {
  id                  String           @id @default(uuid()) @db.Uuid
  email               String           @unique
  passwordHash        String?
  firstName           String?
  lastName            String?
  profileImage        String?
  defaultServings     Int              @default(2)
  dietaryPreferences  String[]
  allergies           String[]
  preferredCuisines   String[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  recipes             Recipe[]
  oauthAccounts       OAuthAccount[]
  shoppingList        ShoppingList?
  cookbooks           Cookbook[]
  cookbookMemberships CookbookMember[]
  comments            RecipeComment[]
  mealPlans           MealPlan[]
  favorites           Favorite[]

  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  userId            String   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Ingredient {
  id                     String   @id @default(uuid())
  name                   String   @unique
  category               String?
  defaultMeasurementUnit String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  recipeIngredients RecipeIngredient[]
  shoppingListItems ShoppingListItem[]
}

model Recipe {
  id String @id @default(uuid())

  name            String
  description     String?
  preparationTime Int?
  cookingTime     Int?
  servings        Int?
  difficulty      String?
  imageUrl        String?
  sourceUrl       String?
  favorite        Boolean  @default(false)
  instructions    String   @default("")
  cookbookId      String?
  userId          String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tags              RecipeTag[]
  mealPlans         MealPlan[]
  comments          RecipeComment[]
  favorites         Favorite[]
  recipeIngredients RecipeIngredient[]

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cookbook Cookbook? @relation(fields: [cookbookId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model RecipeIngredient {
  id String @id @default(uuid())

  recipeId     String
  ingredientId String
  quantity     Float
  unit         String?
  order        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
}

model ShoppingList {
  id String @id @default(uuid())

  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ShoppingListItem[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model ShoppingListItem {
  id String @id @default(uuid())

  shoppingListId String
  ingredientId   String
  quantity       Float
  unit           String?
  checked        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id])
}

model Cookbook {
  id String @id @default(uuid())

  name      String
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes Recipe[]
  members CookbookMember[]

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model CookbookMember {
  id String @id @default(uuid())

  cookbookId String
  userId     String @db.Uuid
  role       String

  cookbook Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cookbookId, userId])
}

model RecipeComment {
  id String @id @default(uuid())

  recipeId  String
  userId    String   @db.Uuid
  content   String
  createdAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  recipe RecipeTag[]
}

model RecipeTag {
  recipeId String
  tagId    String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
}

model Favorite {
  userId    String   @db.Uuid
  recipeId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
}

model MealPlan {
  id String @id @default(uuid()) @db.Uuid

  userId    String   @db.Uuid
  recipeId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  servings  Int?

  day      WeekDay
  mealType MealType

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, day, mealType])
}
