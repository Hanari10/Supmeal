generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String           @id @default(uuid()) @db.Uuid
  email               String           @unique
  passwordHash        String?
  firstName           String?
  lastName            String?
  profileImage        String?
  defaultServings     Int              @default(2)
  dietaryPreferences  String[]
  allergies           String[]
  preferredCuisines   String[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  recipes             Recipe[]
  oauthAccounts       OAuthAccount[]
  shoppingList        ShoppingList?
  cookbooks           Cookbook[]
  cookbookMemberships CookbookMember[]
  comments            RecipeComment[]
  mealPlans           MealPlan[]

  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Ingredient {
  id                     String  @id @default(uuid())
  name                   String  @unique
  category               String?
  defaultMeasurementUnit String?

  recipeIngredients RecipeIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shoppingListItems ShoppingListItem[]
}

model Recipe {
  id String @id @default(uuid())

  name        String
  description String?

  preparationTime Int?
  cookingTime     Int?
  servings        Int?
  difficulty      String?
  imageUrl        String?
  sourceUrl       String?
  favorite        Boolean   @default(false)
  instructions    String    @default("")
  cookbookId      String?
  cookbook        Cookbook? @relation(fields: [cookbookId], references: [id], onDelete: SetNull)

  tags RecipeTag[]
  mealPlans  MealPlan[]
  comments   RecipeComment[]

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipeIngredients RecipeIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RecipeIngredient {
  id String @id @default(uuid())

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  quantity Float

  unit String?

  order Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipeId, ingredientId])
}

model ShoppingList {
  id String @id @default(uuid())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items ShoppingListItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
}

model ShoppingListItem {
  id String @id @default(uuid())

  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  quantity Float

  unit String?

  checked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cookbook {
  id String @id @default(uuid())

  name String

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  recipes Recipe[]
  members CookbookMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CookbookMember {
  id String @id @default(uuid())

  cookbookId String
  cookbook   Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role String

  @@unique([cookbookId, userId])
}

model MealPlan {
  id String @id @default(uuid())

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  date DateTime

  mealType String?
  user     User?   @relation(fields: [userId], references: [id])
  userId   String? @db.Uuid
}

model RecipeComment {
  id String @id @default(uuid())

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content String

  createdAt DateTime @default(now())
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  recipe RecipeTag[]
}

model RecipeTag {
  recipeId String
  tagId    String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
}

