# Base de données PostgreSQL
POSTGRES_DB=supmeal
POSTGRES_USER=supmeal
POSTGRES_PASSWORD=mot_de_passe_a_remplacer
POSTGRES_PORT=5432

# Connexion du serveur à PostgreSQL
DATABASE_URL=postgresql://supmeal:mot_de_passe_a_remplacer@base-de-donnees:5432/supmeal?schema=public

# Serveur
SERVER_PORT=3000
JWT_ACCESS_SECRET=secret_a_remplacer
JWT_REFRESH_SECRET=autre_secret_a_remplacer
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Client web
VITE_API_URL=http://localhost:3000

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback